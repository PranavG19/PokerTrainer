{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmit": false,
    // The server is a plain Node process: no DOM, no Electron. Building it with lib ES2022 only makes a
    // stray DOM or Electron reference in core a compile error here, not a crash on the VPS.
    "rootDir": ".",
    "outDir": "dist-server",
    "declaration": false
  },
  "include": ["server/**/*"]
}
