# Offsuit game server. Installed by setup.sh to /etc/systemd/system/offsuit.service.
[Unit]
Description=Offsuit game server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=offsuit
Group=offsuit
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/offsuit/current/server/main.js --state /var/lib/offsuit --port 443 --host 0.0.0.0 --cert /var/lib/offsuit/tls/fullchain.pem --key /var/lib/offsuit/tls/privkey.pem
# The server re-reads its certificate on SIGHUP (sent by the certbot deploy hook).
ExecReload=/bin/kill -HUP $MAINPID
# The licence server's env (Stripe, signing key path); optional, and off unless OFFSUIT_LICENCE_ENABLED=1.
EnvironmentFile=-/etc/offsuit/licence.env
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

# Bind 443 without running as root; this is the only capability it ever holds.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Read-only system; the state dir is the one writable path.
ProtectSystem=strict
ReadWritePaths=/var/lib/offsuit
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# New state files are private to the service user.
UMask=0077
# MemoryDenyWriteExecute is deliberately absent: V8's JIT needs writable+executable pages.

MemoryMax=400M
TasksMax=64
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
