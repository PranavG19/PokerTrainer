# Licence server env for the Offsuit online server (Pro licensing, docs/PAYMENTS-SETUP.md).
# Copy this file somewhere outside the repo, fill it from `node scripts/payments-setup.ts`'s output, and pass
# it as the 4th argument of server/deploy/deploy.sh. NEVER commit a filled copy: these are secrets.
# Every value below is a placeholder; with OFFSUIT_LICENCE_ENABLED=0 the server ignores the rest.

OFFSUIT_LICENCE_ENABLED=0
# A path ON YOUR MAC to the private key payments-setup.ts wrote (~/.offsuit-licensing/<kid>.json).
# deploy.sh uploads that file to /etc/offsuit/licence-signing-key.json and points this variable there.
OFFSUIT_LICENCE_SIGNING_KEY_FILE=/Users/you/.offsuit-licensing/REPLACE_ME.json
OFFSUIT_LICENCE_PUBLIC_KEYS={"REPLACE_ME_KID":"REPLACE_ME_X"}
OFFSUIT_LICENCE_EMAIL_PEPPER=REPLACE_ME
STRIPE_SECRET_KEY=rk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRETS=whsec_REPLACE_ME
